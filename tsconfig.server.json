{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist-server",
    "rootDir": ".",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": [
    "server.ts",
    "scripts/prepare-db.ts",
    "components/petri/simulation.ts",
    "components/petri/types.ts",
    "lib/**/*.ts"
  ]
}
